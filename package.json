{
  "name": "stoor",
  "version": "2.3.1",
  "description": "Storage wrapper with support for namespacing, timeouts and multi get/set and remove",
  "license": "MIT",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tiaanduplessis/stoor.git"
  },
  "homepage": "https://github.com/tiaanduplessis/stoor",
  "bugs": "https://github.com/tiaanduplessis/stoor/issues",
  "author": {
    "name": "Tiaan",
    "email": "tiaanduplessis@hotmail.com"
  },
  "scripts": {
    "test": "vitest run",
    "test:deno": "npm run build && node scripts/test-deno.mjs",
    "coverage": "vitest run --coverage",
    "build": "rm -rf dist && tsup src/index.ts --format cjs,esm --dts --target node16",
    "prepublishOnly": "npm run build",
    "types:check": "tsc --noEmit",
    "format": "pretty-quick --ignore-path .gitignore",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json vitest.config.mts"
  },
  "keywords": [
    "local-storage",
    "session-storage",
    "namespace",
    "storage",
    "wrapper",
    "stoor"
  ],
  "devDependencies": {
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "pretty-quick": "4.2.2",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2"
    }
  }
}
